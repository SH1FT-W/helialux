      "name": "Set profile",
      "description": "Replaces all points of a profile. The lamp fades between points itself. If 00:00 or 23:59 is missing, the last point is continued there.",
      "fields": {
        "profile": {
          "name": "Profile",
          "description": "Name or slot (e.g. My_Profile or P8). Empty: today's active profile."
        },
        "name": {
          "name": "New name",
          "description": "Optional, at most 16 characters."
        },
        "points": {
          "name": "Points",
          "description": "List of time (HH:MM), white, blue, green, red (0–100 %), optional clouds and cloud_motion (0–3). At most 16 points. Without cloud values the profile keeps its current cloud setting."
